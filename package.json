{
  "name": "douglas-qa-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "serve": "python -m http.server 4173 --bind 127.0.0.1 --directory dist",
    "build": "node scripts/build-static.mjs",
    "check:js": "node scripts/check-syntax.mjs",
    "test:budget": "npm run build && node scripts/check-budgets.mjs",
    "test:lighthouse": "node scripts/run-lighthouse.mjs",
    "test:playwright": "playwright test",
    "test:cypress": "cypress run",
    "test:selenium": "node tests/selenium/site.selenium.test.mjs",
    "test:robot": "node scripts/run-robot.mjs",
    "test:all": "npm run check:js && npm run test:unit && npm run test:budget && npm run test:deployment && npm run test:playwright && npm run test:cypress && npm run test:selenium && npm run test:robot && npm run test:links && npm run test:coverage && npm run test:visual && npm run test:lighthouse",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test:android": "node tests/android/site.android.mjs",
    "test:visual": "playwright test --config playwright.visual.config.mjs",
    "test:coverage": "node scripts/run-coverage.mjs",
    "test:links": "node scripts/check-public-links.mjs",
    "test:deployment": "node scripts/verify-deployment.mjs",
    "test:appium": "node tests/appium/site.appium.mjs",
    "prepare:appium": "node scripts/prepare-appium.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.59.1",
    "chrome-launcher": "^1.2.1",
    "cypress": "^15.14.2",
    "esbuild": "^0.28.1",
    "istanbul-lib-coverage": "^3.2.2",
    "istanbul-lib-report": "^3.0.1",
    "istanbul-reports": "^3.2.0",
    "lighthouse": "^13.4.1",
    "selenium-webdriver": "^4.43.0",
    "sharp": "^0.35.4",
    "v8-to-istanbul": "^9.3.0"
  }
}
